# Copy to `.env` for local dev and fill in real values.
# `.env*` is gitignored except this file — never commit real secrets here.
# See specs/12-Architecture.md §12.9 and src/server/config/index.ts.

# Path to the persistent data directory: SQLite file + raw PDGA response cache.
DATA_DIR=./data

# Port the Node process listens on (nginx proxies to this in production).
PORT=3000

# Auth.js signing secret — generate with `npx auth secret` (>= 32 chars).
AUTH_SECRET=replace-with-a-random-32-char-or-longer-secret

# Google OAuth client id, from the Google Cloud console (Auth.js Google provider).
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Google OAuth client secret, from the Google Cloud console (Auth.js Google provider).
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Email seeded into the `directors` table on first boot (idempotent); thereafter the table is authoritative.
BOOTSTRAP_DIRECTOR_EMAIL=director@example.com

# IANA timezone used for display (e.g. "Updated ... ET") and the scheduler.
APP_TIMEZONE=America/New_York

# Standard Node environment: development | test | production.
NODE_ENV=development
